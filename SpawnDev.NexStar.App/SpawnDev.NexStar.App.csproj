<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
		<PackageReference Include="SGP.NET" Version="1.4.0" />
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.4" />
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.4" />
		<PackageReference Include="SpawnDev.GameUI" Version="1.1.1-local.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.NexStar\SpawnDev.NexStar.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>

</Project>
