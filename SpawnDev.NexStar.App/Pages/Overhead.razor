@page "/overhead"
@using SpawnDev.NexStar.App.Services
@inject OverheadService OverheadService
@inject NexStarService NexStar
@inject LocationService LocationService
@implements IDisposable

<PageTitle>Overhead - NexStar Control</PageTitle>

<div class="overhead-container">
    <!-- Filter Panel -->
    <div class="filter-panel @(FiltersExpanded ? "expanded" : "collapsed")">
        <div class="filter-header" @onclick="() => FiltersExpanded = !FiltersExpanded">
            <span>⚙️ Filters</span>
            <span class="toggle-icon">@(FiltersExpanded ? "▲" : "▼")</span>
        </div>
        @if (FiltersExpanded)
        {
            <div class="filter-options">
                <label class="filter-checkbox">
                    <input type="checkbox" @bind="Filters.ShowSatellites" @bind:after="RefreshObjects" />
                    <span class="sat-icon">🛰️</span> Satellites
                </label>
                <label class="filter-checkbox">
                    <input type="checkbox" @bind="Filters.ShowPlanes" @bind:after="RefreshObjects" />
                    <span class="plane-icon">✈️</span> Planes
                </label>
                <label class="filter-checkbox">
                    <input type="checkbox" @bind="Filters.ShowPlanets" @bind:after="RefreshObjects" />
                    <span>🪐</span> Planets
                </label>
                <label class="filter-checkbox">
                    <input type="checkbox" @bind="Filters.ShowMoon" @bind:after="RefreshObjects" />
                    <span>🌙</span> Moon
                </label>
                <label class="filter-checkbox">
                    <input type="checkbox" @bind="Filters.ShowStars" @bind:after="RefreshObjects" />
                    <span>⭐</span> Stars
                </label>
                <label class="filter-checkbox">
                    <input type="checkbox" @bind="Filters.ShowDSOs" @bind:after="RefreshObjects" />
                    <span>🌌</span> DSOs
                </label>
            </div>
        }
    </div>

    <!-- Sky Map -->
    <div class="sky-map-container" @onwheel="OnWheel" @onmousedown="OnMouseDown" @onmousemove="OnMouseMove" @onmouseup="OnMouseUp">
        @if (LocationService.Location == null)
        {
            <div class="no-location">
                <p>📍 Location required</p>
                <small>Connect telescope or enable browser location</small>
            </div>
        }
        else
        {
            <svg viewBox="-110 -110 220 220" class="sky-map" style="max-width: calc(100vw - 240px); max-height: calc(100vh - 120px); width: auto; height: auto; aspect-ratio: 1 / 1;" @ref="svgElement">
                <!-- Background (fixed, doesn't zoom) -->
                <circle cx="0" cy="0" r="100" class="horizon-circle" />
                
                <!-- Cardinal directions (fixed) -->
                <text x="0" y="-103" class="cardinal-text">N</text>
                <text x="0" y="108" class="cardinal-text">S</text>
                <text x="103" y="3" class="cardinal-text">E</text>
                <text x="-103" y="3" class="cardinal-text">W</text>
                
                <!-- Zoomable content -->
                <g transform="translate(0,0) scale(@ZoomLevel)">
                    <!-- Altitude circles -->
                    <circle cx="0" cy="0" r="66.67" class="alt-circle" />
                    <circle cx="0" cy="0" r="33.33" class="alt-circle" />
                    <circle cx="0" cy="0" r="5" class="zenith-marker" />
                    
                    <!-- Cardinal lines -->
                    <line x1="0" y1="-100" x2="0" y2="100" class="cardinal-line" />
                    <line x1="-100" y1="0" x2="100" y2="0" class="cardinal-line" />
                    
                    <!-- Altitude labels -->
                    @((MarkupString)$"<text x=\"2\" y=\"-68\" class=\"alt-label\" style=\"font-size: {5 / ZoomLevel}px;\">30°</text>")
                    @((MarkupString)$"<text x=\"2\" y=\"-35\" class=\"alt-label\" style=\"font-size: {5 / ZoomLevel}px;\">60°</text>")
                    
                    <!-- Objects -->
                    @foreach (var obj in VisibleObjects)
                    {
                        var (x, y) = AltAzToXY(obj.Azimuth, obj.Altitude);
                        var size = GetObjectSize(obj);
                        var color = GetObjectColor(obj);
                        
                        <g class="sky-object @(SelectedObject?.Id == obj.Id ? "selected" : "")" 
                           @onclick="() => SelectObject(obj)"
                           @onmouseenter="() => HoveredObject = obj"
                           @onmouseleave="() => HoveredObject = null">
                            @((MarkupString)$"<text x=\"{x}\" y=\"{y}\" class=\"object-icon\" style=\"font-size: {size * 2 / ZoomLevel}px;\">{GetObjectIcon(obj)}</text>")
                            @if (ZoomLevel > 1.5 || obj.Category == "Satellite" || obj.Category == "Plane")
                            {
                                @((MarkupString)$"<text x=\"{x + size + 4}\" y=\"{y + 2}\" class=\"object-label\" style=\"font-size: {4 / ZoomLevel}px;\">{obj.Name}</text>")
                            }
                        </g>
                    }
                </g>
                
                <!-- Telescope Position Indicator -->
                @if (NexStar.SerialPortSelected && TelescopeAz.HasValue && TelescopeAlt.HasValue && TelescopeAlt.Value >= 0)
                {
                    var (tx, ty) = AltAzToXY(TelescopeAz.Value, TelescopeAlt.Value);
                    <g class="telescope-indicator">
                        <!-- Crosshairs -->
                        <line x1="@(tx - 8)" y1="@ty" x2="@(tx + 8)" y2="@ty" class="telescope-crosshair" />
                        <line x1="@tx" y1="@(ty - 8)" x2="@tx" y2="@(ty + 8)" class="telescope-crosshair" />
                        <!-- Outer circle -->
                        <circle cx="@tx" cy="@ty" r="6" class="telescope-circle" />
                        <!-- Center dot -->
                        <circle cx="@tx" cy="@ty" r="1.5" class="telescope-center" />
                    </g>
                }
            </svg>
            
            <!-- Tooltip -->
            @if (HoveredObject != null)
            {
                <div class="tooltip" style="@TooltipStyle">
                    <div class="tooltip-title">@HoveredObject.Name</div>
                    <div class="tooltip-info">@HoveredObject.Category - @HoveredObject.Subcategory</div>
                    <div class="tooltip-coords">Az: @HoveredObject.Azimuth.ToString("F1")° | Alt: @HoveredObject.Altitude.ToString("F1")°</div>
                    @if (!string.IsNullOrEmpty(HoveredObject.ExtraInfo))
                    {
                        <div class="tooltip-extra">@HoveredObject.ExtraInfo</div>
                    }
                </div>
            }
        }
    </div>

    <!-- Selected Object Panel -->
    @if (SelectedObject != null)
    {
        <div class="selected-panel">
            <div class="selected-header">
                <span class="selected-name">@SelectedObject.Name</span>
                <button class="close-btn" @onclick="() => SelectedObject = null">✕</button>
            </div>
            <div class="selected-info">
                <span>@SelectedObject.Category</span> · <span>@SelectedObject.Subcategory</span>
            </div>
            <div class="selected-coords">
                <div>Az: <strong>@SelectedObject.Azimuth.ToString("F2")°</strong></div>
                <div>Alt: <strong>@SelectedObject.Altitude.ToString("F2")°</strong></div>
            </div>
            @if (!string.IsNullOrEmpty(SelectedObject.ExtraInfo))
            {
                <div class="selected-extra">@SelectedObject.ExtraInfo</div>
            }
            <div class="selected-actions">
                <button class="btn-goto" @onclick="GoToSelected" disabled="@(!NexStar.SerialPortSelected)">
                    🎯 GoTo
                </button>
                @if (SelectedObject.Category == "Satellite" || SelectedObject.Category == "Plane")
                {
                    <button class="btn-track" @onclick="TrackSelected" disabled="@(!NexStar.SerialPortSelected)">
                        🔄 Track
                    </button>
                }
            </div>
        </div>
    }
    
    <!-- Status bar -->
    <div class="status-bar">
        <span>@VisibleObjects.Count objects</span>
        <span>Zoom: @ZoomLevel.ToString("F1")x</span>
        <button class="refresh-btn" @onclick="RefreshObjects">🔄</button>
    </div>
</div>

@code {
    private List<SkyObject> VisibleObjects = new();
    private SkyObject? SelectedObject;
    private SkyObject? HoveredObject;
    private OverheadService.FilterSettings Filters = new();
    private bool FiltersExpanded = false;
    private double ZoomLevel = 1.0;
    private System.Threading.Timer? RefreshTimer;
    private ElementReference svgElement;
    
    // Telescope position
    private double? TelescopeAz;
    private double? TelescopeAlt;
    
    // Mouse tracking for tooltip
    private string TooltipStyle => HoveredObject != null ? "display: block;" : "display: none;";

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to data updates from the service
        OverheadService.OnDataUpdated += OnServiceDataUpdated;
        
        await RefreshObjects();
        
        // Fast refresh timer - sources manage their own rate limiting
        RefreshTimer = new System.Threading.Timer(async _ => 
        {
            await RefreshObjects();
            await InvokeAsync(StateHasChanged);
        }, null, 2000, 2000);
    }

    private void OnServiceDataUpdated()
    {
        // When any source updates, refresh UI
        InvokeAsync(() =>
        {
            VisibleObjects = OverheadService.GetVisibleObjects(Filters);
            
            // Update selected object with fresh data if it still exists
            if (SelectedObject != null)
            {
                var updated = VisibleObjects.FirstOrDefault(o => o.Id == SelectedObject.Id);
                if (updated != null)
                {
                    SelectedObject = updated;
                }
            }
            
            StateHasChanged();
        });
    }

    private async Task RefreshObjects()
    {
        if (LocationService.Location != null)
        {
            // This triggers source refreshes (non-blocking) and returns cached data immediately
            VisibleObjects = await OverheadService.GetVisibleObjectsAsync(Filters);
            
            // Get telescope position if connected
            if (NexStar.SerialPortSelected)
            {
                try
                {
                    var pos = await NexStar.GetAzAltAsync();
                    TelescopeAz = pos.Azimuth;
                    TelescopeAlt = pos.Altitude;
                }
                catch
                {
                    TelescopeAz = null;
                    TelescopeAlt = null;
                }
            }
            else
            {
                TelescopeAz = null;
                TelescopeAlt = null;
            }
            
            StateHasChanged();
        }
    }

    private (double x, double y) AltAzToXY(double az, double alt)
    {
        // Polar projection: radius = (90 - alt) / 90 * 100
        double r = (90 - alt) / 90.0 * 100;
        // Azimuth: 0 = North (top), 90 = East (right)
        double azRad = (az - 90) * Math.PI / 180; // offset so N is up
        double x = r * Math.Cos(azRad);
        double y = r * Math.Sin(azRad);
        return (Math.Round(x, 2), Math.Round(y, 2));
    }

    private double GetObjectSize(SkyObject obj)
    {
        return obj.Category switch
        {
            "Satellite" => 3,
            "Plane" => 4,
            "Planet" => 5,
            "Star" => Math.Max(1, 4 - (obj.Magnitude ?? 2)),
            "DSO" => 3,
            _ => 2
        };
    }

    private string GetObjectColor(SkyObject obj)
    {
        return obj.Category switch
        {
            "Satellite" => "#00ffff",
            "Plane" => "#ff9900",
            "Planet" => "#ffff00",
            "Star" => "#ffffff",
            "DSO" => "#ff66ff",
            _ => "#888888"
        };
    }

    private string GetObjectIcon(SkyObject obj)
    {
        return obj.Category switch
        {
            "Satellite" => "🛰️",
            "Plane" => "✈️",
            "Planet" => "🪐",
            "Moon" => "🌙",
            "Star" => "⭐",
            "DSO" => "🌌",
            _ => "●"
        };
    }

    private void SelectObject(SkyObject obj)
    {
        SelectedObject = obj;
    }

    private async Task GoToSelected()
    {
        if (SelectedObject == null || !NexStar.SerialPortSelected) return;
        
        if (SelectedObject.Ra.HasValue && SelectedObject.Dec.HasValue)
        {
            await NexStar.GotoRaDecAsync(SelectedObject.Ra.Value, SelectedObject.Dec.Value);
        }
        else
        {
            await NexStar.GotoAzAltAsync(SelectedObject.Azimuth, SelectedObject.Altitude);
        }
    }

    private async Task TrackSelected()
    {
        if (SelectedObject == null) return;
        // Navigate to appropriate tracker
        // For now just do GoTo
        await GoToSelected();
    }

    private void OnWheel(WheelEventArgs e)
    {
        ZoomLevel = Math.Clamp(ZoomLevel + (e.DeltaY > 0 ? -0.1 : 0.1), 0.5, 3.0);
    }

    private void OnMouseDown(MouseEventArgs e) { }
    private void OnMouseMove(MouseEventArgs e) { }
    private void OnMouseUp(MouseEventArgs e) { }

    public void Dispose()
    {
        OverheadService.OnDataUpdated -= OnServiceDataUpdated;
        RefreshTimer?.Dispose();
    }
}

<style>
    .overhead-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        background: #0a0a0f;
        color: #e0e0e0;
        overflow: hidden;
    }

    .filter-panel {
        flex-shrink: 0;
        background: #1a1a25;
        border-bottom: 1px solid #333;
    }

    .filter-header {
        display: flex;
        justify-content: space-between;
        padding: 6px 10px;
        cursor: pointer;
        font-weight: bold;
        font-size: 0.85rem;
    }

    .filter-options {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 6px 10px;
        background: #15151f;
    }

    .filter-checkbox {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        background: #222;
        border-radius: 12px;
        cursor: pointer;
        font-size: 0.8rem;
    }

    .filter-checkbox input {
        accent-color: #ff4444;
    }

    .sky-map-container {
        flex: 1;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        touch-action: none;
        padding: 8px;
    }

    .sky-map {
        width: auto;
        height: auto;
        max-width: calc(100vw - 240px);
        max-height: calc(100vh - 150px);
        aspect-ratio: 1 / 1;
    }

    .horizon-circle {
        fill: #0d0d15;
        stroke: #444;
        stroke-width: 1;
    }

    .alt-circle {
        fill: none;
        stroke: #2a2a35;
        stroke-width: 0.5;
        stroke-dasharray: 3 3;
    }

    .zenith-marker {
        fill: none;
        stroke: #ff4444;
        stroke-width: 0.5;
    }

    .cardinal-line {
        stroke: #2a2a35;
        stroke-width: 0.3;
    }

    .cardinal-text {
        font-size: 8px;
        fill: #888;
        text-anchor: middle;
        dominant-baseline: middle;
    }

    .alt-label {
        font-size: 5px;
        fill: #555;
    }

    /* Telescope position indicator */
    .telescope-crosshair {
        stroke: #ff4444;
        stroke-width: 1.5;
        stroke-linecap: round;
    }

    .telescope-circle {
        fill: none;
        stroke: #ff4444;
        stroke-width: 1.5;
    }

    .telescope-center {
        fill: #ff4444;
    }

    .telescope-indicator {
        pointer-events: none;
        filter: drop-shadow(0 0 3px rgba(255, 68, 68, 0.8));
    }

    .object-icon {
        cursor: pointer;
        text-anchor: middle;
        dominant-baseline: central;
        pointer-events: all;
    }

    .sky-object:hover .object-icon {
        filter: drop-shadow(0 0 4px white);
    }

    .sky-object.selected .object-icon {
        filter: drop-shadow(0 0 6px #ff4444);
    }

    .object-label {
        font-size: 4px;
        fill: #aaa;
        pointer-events: none;
    }

    .tooltip {
        position: absolute;
        background: rgba(20, 20, 30, 0.95);
        border: 1px solid #444;
        border-radius: 6px;
        padding: 8px 12px;
        pointer-events: none;
        z-index: 100;
        max-width: 200px;
        font-size: 0.85rem;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -100%);
    }

    .tooltip-title {
        font-weight: bold;
        color: #fff;
    }

    .tooltip-info {
        color: #888;
        font-size: 0.8rem;
    }

    .tooltip-coords {
        color: #66ccff;
        margin-top: 4px;
    }

    .tooltip-extra {
        color: #aaa;
        font-size: 0.75rem;
        margin-top: 4px;
    }

    .selected-panel {
        background: #1a1a25;
        border-top: 1px solid #333;
        padding: 12px 15px;
    }

    .selected-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .selected-name {
        font-size: 1.1rem;
        font-weight: bold;
        color: #fff;
    }

    .close-btn {
        background: none;
        border: none;
        color: #888;
        font-size: 1.2rem;
        cursor: pointer;
    }

    .selected-info {
        color: #888;
        font-size: 0.85rem;
    }

    .selected-coords {
        display: flex;
        gap: 20px;
        margin: 8px 0;
        color: #66ccff;
    }

    .selected-extra {
        color: #aaa;
        font-size: 0.85rem;
    }

    .selected-actions {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .btn-goto, .btn-track {
        flex: 1;
        padding: 10px;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
    }

    .btn-goto {
        background: #ff4444;
        color: white;
    }

    .btn-goto:disabled {
        background: #444;
        color: #888;
    }

    .btn-track {
        background: #4488ff;
        color: white;
    }

    .btn-track:disabled {
        background: #444;
        color: #888;
    }

    .status-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 15px;
        background: #111;
        font-size: 0.8rem;
        color: #666;
    }

    .refresh-btn {
        background: none;
        border: 1px solid #444;
        color: #888;
        padding: 4px 8px;
        border-radius: 4px;
        cursor: pointer;
    }

    .no-location {
        text-align: center;
        color: #888;
    }

    .no-location p {
        font-size: 1.5rem;
        margin-bottom: 5px;
    }

    /* Responsive */
    @@media (min-width: 768px) {
        .overhead-container {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .filter-panel {
            width: 200px;
            border-right: 1px solid #333;
            border-bottom: none;
        }

        .filter-panel.collapsed {
            width: 200px;
        }

        .filter-options {
            flex-direction: column;
        }

        .sky-map-container {
            flex: 1;
            min-width: 300px;
        }

        .selected-panel {
            width: 250px;
            border-top: none;
            border-left: 1px solid #333;
        }

        .status-bar {
            width: 100%;
        }
    }
</style>
