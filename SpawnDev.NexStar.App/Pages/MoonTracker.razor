            font-size: 1.1rem;
            color: #a1a1aa;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

    /* Moon Phase Display */
    .moon-phase-display {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .phase-emoji {
        font-size: 4rem;
        line-height: 1;
    }

    .phase-info {
        display: flex;
        flex-direction: column;
    }

    .phase-name {
        font-size: 1.3rem;
        font-weight: 600;
        color: #fbbf24;
    }

    .illumination {
        color: #a1a1aa;
    }

    /* Position */
    .moon-position {
        margin-bottom: 1rem;
    }

    .position-row {
        display: flex;
        gap: 2rem;
        margin-bottom: 0.75rem;
    }

    .position-item {
        text-align: center;
    }

        .position-item label {
            display: block;
            font-size: 0.7rem;
            color: #71717a;
            text-transform: uppercase;
        }

        .position-item span {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.2rem;
        }

    .visibility-status {
        text-align: center;
        padding: 0.5rem;
        border-radius: 8px;
        font-size: 0.9rem;
    }

        .visibility-status.visible {
            background: rgba(74, 222, 128, 0.1);
            color: #4ade80;
        }

        .visibility-status.not-visible {
            background: rgba(161, 161, 170, 0.1);
            color: #71717a;
        }

    /* Rise/Set Times */
    .rise-set-times {
        display: flex;
        justify-content: space-around;
        margin: 1rem 0;
        padding: 0.75rem;
        background: rgba(0, 0, 0, 0.2);
