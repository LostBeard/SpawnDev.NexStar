        text-align: center;
        padding: 1.5rem;
        background: linear-gradient(135deg, #0d0d10 0%, #131318 100%);
        border: 1px solid rgba(234, 179, 8, 0.2);
        border-radius: 16px;
        margin-bottom: 1.5rem;
    }

