    }

    .vis-badge {
        font-size: 0.7rem;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
    }

        .vis-badge.good {
            background: rgba(74, 222, 128, 0.2);
            color: #4ade80;
        }

        .vis-badge.dim {
            background: rgba(161, 161, 170, 0.2);
            color: #71717a;
        }

