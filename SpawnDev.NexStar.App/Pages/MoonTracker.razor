@page "/moon"
@using SpawnDev.NexStar.App.Services
@inject NexStarService NexStar
@inject LocationService LocationService
@implements IDisposable

<PageTitle>Moon Tracker</PageTitle>

<div class="moon-tracker-app">
    <header class="app-header">
        <h1>🌙 Moon Tracker</h1>
        <span class="subtitle">Lunar Observation Tool</span>
    </header>

    <main class="app-main">
        <!-- Current Moon Status -->
        <section class="panel status-panel">
            <div class="moon-phase-display">
                <span class="phase-emoji">@LunarMath.GetMoonPhaseEmoji(_currentTime)</span>
                <div class="phase-info">
                    <span class="phase-name">@LunarMath.GetMoonPhaseName(_currentTime)</span>
                    <span class="illumination">@Math.Round(LunarMath.GetMoonIllumination(_currentTime), 1)% illuminated</span>
                </div>
            </div>

            @if (_hasLocation)
            {
                <div class="moon-position">
                    <div class="position-row">
                        <div class="position-item">
                            <label>Altitude</label>
                            <span class="@(_moonAzAlt.Altitude > 0 ? "status-good" : "status-dim")">
                                @Math.Round(_moonAzAlt.Altitude, 1)°
                            </span>
                        </div>
                        <div class="position-item">
                            <label>Azimuth</label>
                            <span>@Math.Round(_moonAzAlt.Azimuth, 1)°</span>
                        </div>
                    </div>
                    <div class="visibility-status @(_moonAzAlt.Altitude > 0 ? "visible" : "not-visible")">
                        @if (_moonAzAlt.Altitude > 0)
                        {
                            <span>🌙 Moon is above the horizon</span>
                        }
                        else
                        {
                            <span>🌑 Moon is below the horizon</span>
                        }
                    </div>
                </div>

                <div class="rise-set-times">
                    <div class="time-item">
                        <label>Rise</label>
                        <span>@FormatTime(_moonRise)</span>
                    </div>
                    <div class="time-item">
                        <label>Transit</label>
                        <span>@FormatTime(_moonTransit)</span>
                    </div>
                    <div class="time-item">
                        <label>Set</label>
                        <span>@FormatTime(_moonSet)</span>
                    </div>
                </div>
            }
            else
            {
                <div class="no-location">
                    <p>📍 Location not available</p>
                    <p class="hint">Connect telescope or <span style="cursor: pointer; text-decoration: underline; font-weight: bold;" @onclick="(() => LocationService.RequestBrowserLocationAsync())">enable GPS</span> to show location based information</p>
                </div>
            }

            @if (NexStar.ComsEnabled && _hasLocation && _moonAzAlt.Altitude > 0)
            {
                <button class="btn btn-primary" @onclick="GotoMoon" disabled="@_isLoading">
                    🎯 Go to Moon
                </button>
            }
        </section>

        <!-- 30-Day Forecast -->
        <section class="panel forecast-panel">
            <h2>30-Day Visibility Forecast</h2>
            <div class="forecast-grid">
                @foreach (var day in _forecast)
                {
                    <div class="forecast-day @GetVisibilityClass(day)">
                        <span class="day-date">@day.Date.ToString("M/d")</span>
                        <span class="day-phase">@day.PhaseEmoji</span>
                        <span class="day-illum">@Math.Round(day.Illumination)%</span>
                        @if (day.MaxAltitude.HasValue)
                        {
                            <span class="day-alt">@Math.Round(day.MaxAltitude.Value)°</span>
                        }
                    </div>
                }
            </div>
            <div class="forecast-legend">
                <span class="legend-item good">● Good</span>
                <span class="legend-item fair">● Fair</span>
                <span class="legend-item poor">● Poor</span>
            </div>
        </section>

        <!-- Lunar Features -->
        <section class="panel features-panel">
            <h2>Lunar Features</h2>
            <div class="feature-filters">
                <button class="filter-btn @(_featureFilter == "" ? "active" : "")" @onclick="@(() => SetFeatureFilter(string.Empty))">All</button>
                <button class="filter-btn @(_featureFilter == "Crater" ? "active" : "")" @onclick='() => SetFeatureFilter("Crater")'>Craters</button>
                <button class="filter-btn @(_featureFilter == "Mare" ? "active" : "")" @onclick='() => SetFeatureFilter("Mare")'>Maria</button>
                <button class="filter-btn @(_featureFilter == "Mountain" ? "active" : "")" @onclick='() => SetFeatureFilter("Mountain")'>Mountains</button>
            </div>
            <div class="feature-list">
                @foreach (var feature in GetFilteredFeatures().Take(20))
                {
                    var isVisible = LunarMath.IsFeatureVisible(feature.Longitude, feature.Latitude, _currentTime);
                    <div class="feature-item @(isVisible ? "visible" : "hidden")">
                        <div class="feature-main">
                            <span class="feature-name">@feature.Name</span>
                            <span class="feature-type">@feature.Type</span>
                        </div>
                        <div class="feature-details">
                            <span class="feature-coords">@feature.Latitude.ToString("+0.0;-0.0")°, @feature.Longitude.ToString("+0.0;-0.0")°</span>
                            @if (feature.Diameter > 0)
                            {
                                <span class="feature-size">@feature.Diameter km</span>
                            }
                        </div>
                        <div class="feature-visibility">
                            @if (isVisible)
                            {
                                <span class="vis-badge good">Visible</span>
                            }
                            else
                            {
                                <span class="vis-badge dim">In Shadow</span>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (GetFilteredFeatures().Count() > 20)
            {
                <p class="hint">Showing top 20 of @GetFilteredFeatures().Count() features</p>
            }
        </section>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="status-message @_statusClass">@_statusMessage</div>
        }
    </main>
</div>

@code {
    private DateTime _currentTime = DateTime.UtcNow;
    private bool _hasLocation = false;
    private double _latitude = 0;
    private double _longitude = 0;
    private AzAltCoordinates _moonAzAlt = new();
    private DateTime? _moonRise;
    private DateTime? _moonSet;
    private DateTime? _moonTransit;
    private List<DayForecast> _forecast = new();
    private string _featureFilter = "";
    private bool _isLoading = false;
    private string _statusMessage = "";
    private string _statusClass = "";
    private System.Timers.Timer? _updateTimer;

    protected override void OnInitialized()
    {
        // Update location and time and then the data based on that
        UpdateLocation();

        LocationService.OnLocationChanged += LocationService_OnLocationChanged;

        // Update every minute
        _updateTimer = new System.Timers.Timer(60000);
        _updateTimer.Elapsed += (s, e) =>
        {
            _currentTime = DateTime.UtcNow;
            UpdateMoonData();
            InvokeAsync(StateHasChanged);
        };
        _updateTimer.Start();
    }

    private void LocationService_OnLocationChanged()
    {
        UpdateLocation();
    }

    private void UpdateLocation()
    {
        if (LocationService.Location != null)
        {
            _latitude = LocationService.Location.Latitude;
            _longitude = LocationService.Location.Longitude;
            _hasLocation = true;
        }
        else if (NexStar.Location != null)
        {
            _latitude = NexStar.Location.Latitude;
            _longitude = NexStar.Location.Longitude;
            _hasLocation = true;
        }
        UpdateMoonData();
        GenerateForecast();
    }

    private void UpdateMoonData()
    {
        _currentTime = DateTime.UtcNow;

        if (_hasLocation)
        {
            _moonAzAlt = LunarMath.GetMoonAzAlt(_latitude, _longitude, _currentTime);
            var riseSet = LunarMath.GetMoonRiseSetTransit(_latitude, _longitude, _currentTime);
            _moonRise = riseSet.Rise;
            _moonSet = riseSet.Set;
            _moonTransit = riseSet.Transit;
        }
    }

    private void GenerateForecast()
    {
        _forecast.Clear();
        var today = DateTime.UtcNow.Date;

        for (int i = 0; i < 30; i++)
        {
            var date = today.AddDays(i);
            var noon = date.AddHours(12);

            var day = new DayForecast
            {
                Date = date,
                PhaseEmoji = LunarMath.GetMoonPhaseEmoji(noon),
                PhaseName = LunarMath.GetMoonPhaseName(noon),
                Illumination = LunarMath.GetMoonIllumination(noon)
            };

            if (_hasLocation)
            {
                var riseSet = LunarMath.GetMoonRiseSetTransit(_latitude, _longitude, date);
                day.Rise = riseSet.Rise;
                day.Set = riseSet.Set;

                if (riseSet.Transit.HasValue)
                {
                    var transitPos = LunarMath.GetMoonAzAlt(_latitude, _longitude, riseSet.Transit.Value);
                    day.MaxAltitude = transitPos.Altitude;
                }
            }

            _forecast.Add(day);
        }
    }

    private async Task GotoMoon()
    {
        if (!NexStar.ComsEnabled || !_hasLocation) return;

        _isLoading = true;
        _statusMessage = "Slewing to Moon...";
        _statusClass = "info";
        StateHasChanged();

        try
        {
            // Get current Moon position
            var moonPos = LunarMath.GetMoonPosition(DateTime.UtcNow);

            // Convert RA from degrees to the format NexStar expects
            await NexStar.GotoRaDecAsync(moonPos.RightAscension, moonPos.Declination);

            _statusMessage = "✓ Slewing to Moon";
            _statusClass = "success";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
            _statusClass = "error";
        }

        _isLoading = false;
        StateHasChanged();
    }

    private void SetFeatureFilter(string filter)
    {
        _featureFilter = filter;
    }

    private IEnumerable<MoonFeature> GetFilteredFeatures()
    {
        var features = LunarFeatureCatalog.Features;

        if (!string.IsNullOrEmpty(_featureFilter))
        {
            if (_featureFilter == "Mountain")
            {
                features = features.Where(f =>
                    f.Type == "Mons" || f.Type == "Montes" || f.Type == "Mountain").ToList();
            }
            else
            {
                features = features.Where(f => f.Type == _featureFilter).ToList();
            }
        }

        // Sort: visible features first, then by name
        return features.OrderByDescending(f => LunarMath.IsFeatureVisible(f.Longitude, f.Latitude, _currentTime))
                       .ThenBy(f => f.Name);
    }

    private string FormatTime(DateTime? time)
    {
        if (!time.HasValue) return "--:--";
        return time.Value.ToLocalTime().ToString("HH:mm");
    }

    private string GetVisibilityClass(DayForecast day)
    {
        if (!day.MaxAltitude.HasValue) return "poor";
        if (day.MaxAltitude.Value > 45 && day.Illumination > 20) return "good";
        if (day.MaxAltitude.Value > 20 && day.Illumination > 10) return "fair";
        return "poor";
    }

    public void Dispose()
    {
        LocationService.OnLocationChanged -= LocationService_OnLocationChanged;
        _updateTimer?.Stop();
        _updateTimer?.Dispose();
    }

    private class DayForecast
    {
        public DateTime Date { get; set; }
        public string PhaseEmoji { get; set; } = "";
        public string PhaseName { get; set; } = "";
        public double Illumination { get; set; }
        public DateTime? Rise { get; set; }
        public DateTime? Set { get; set; }
        public double? MaxAltitude { get; set; }
    }
}

<style>
    .moon-tracker-app {
        font-family: 'Inter', 'Segoe UI', -apple-system, sans-serif;
        max-width: 600px;
        margin: 0 auto;
        padding: 1rem;
