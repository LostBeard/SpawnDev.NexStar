@page "/home"
@inject NexStarService NexStar
@inject SpawnJSRuntime JS
@implements IDisposable
@using SpawnDev.SpawnJS.JSObjects

<PageTitle>NexStar Telescope Control</PageTitle>

<div class="telescope-app">
    <!-- Header -->
    <header class="app-header">
        <h1>🔭 NexStar Telescope Control</h1>
        <div class="connection-status">
            @if (NexStar.ComsEnabled)
            {
                <span class="status connected">Connected</span>
                <span class="model-info">@NexStar.Model.GetDisplayName() @NexStar.Version</span>
            }
            else if (NexStar.SerialPortSelected)
            {
                <span class="status ready">Ready</span>
            }
            else
            {
                <span class="status disconnected">Disconnected</span>
            }
        </div>
    </header>

    <main class="app-main">
        <!-- Connection Panel -->
        <section class="panel connection-panel">
            <h2>Connection</h2>
            <div class="button-row">
                @if (!NexStar.SerialPortSelected || !NexStar.ComsEnabled)
                {
                    <button class="btn btn-primary" @onclick="ConnectSerial" disabled="@_isLoading">
                        <span class="icon">🔌</span> Connect Serial
                    </button>
                    <button class="btn btn-primary" @onclick="ConnectUSB" disabled="@_isLoading">
                        <span class="icon">🔌</span> Connect USB
                    </button>
                }
                else
                {
                    <button class="btn btn-danger" @onclick="Disconnect" disabled="@_isLoading">
                        <span class="icon">■</span> Disconnect
                    </button>
                    <button class="btn btn-secondary" @onclick="RefreshInfo" disabled="@_isLoading">
                        <span class="icon">↻</span> Refresh
                    </button>
                }
            </div>
            <div class="info-grid @(!NexStar.ComsEnabled ? "disabled-section" : "")">
                <div class="info-item">
                    <label>Alignment</label>
                    <span class="@(NexStar.IsAligned ? "status-good" : "status-warn")">
                        @(NexStar.ComsEnabled ? (NexStar.IsAligned ? "Aligned" : "Not Aligned") : "—")
                    </span>
                </div>
                <div class="info-item">
                    <label>Tracking</label>
                    <span>@(NexStar.ComsEnabled? NexStar.CurrentTrackingMode.ToString() : "—")</span>
                </div>
            </div>
            @if (NexStar.ComsEnabled)
            {
                <div class="divider"></div>
                <!-- Time Drift -->
                <div class="sync-row">
                    <div class="sync-details">
                        <div class="sync-header">
                            <label>Time Sync</label>
                            <span class="@GetTimeDriftClass()">
                                @(_timeDiff.TotalSeconds >= 0 ? "+" : "")@GetFriendlyTimeSpan(_timeDiff) Diff
                            </span>
                        </div>
                        <div class="sync-values">
                            <div class="value-pair">
                                <span class="label">Device:</span>
                                <span class="value">@(_telescopeTime?.LocalTime.ToString("HH:mm:ss") ?? "--:--:--")</span>
                            </div>
                            <div class="value-pair">
                                <span class="label">Browser:</span>
                                <span class="value">@DateTime.Now.ToString("HH:mm:ss")</span>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-sm" @onclick="SyncTime" disabled="@(_isLoading)">Sync</button>
                </div>

                <!-- Location Drift -->
                <div class="sync-row">
                    <div class="sync-details">
                        <div class="sync-header">
                            <label>Location Sync</label>
                            <span class="@GetLocationDriftClass()">
                                @if (_browserLat != null)
                                {
                                    @($"{Math.Round(_locationDiffKm, 2)} km")
                                }
                                else
                                {
                                    <span class="muted">Waiting for GPS...</span>
                                }
                            </span>
                        </div>
                        <div class="sync-values">
                            <div class="value-pair">
                                <span class="label">Device:</span>
                                <span class="value">
                                    @if (NexStar.Location != null)
                                    {
                                        var lat = NexStar.Location.Latitude;
                                        var lon = NexStar.Location.Longitude;
                                        @($"{Math.Abs(lat):F4}°{(lat >= 0 ? "N" : "S")}, {Math.Abs(lon):F4}°{(lon >= 0 ? "E" : "W")}")
                                    }
                                    else
                                    {
                                        @("--")
                                    }
                                </span>
                            </div>
                            <div class="value-pair">
                                <span class="label">Browser:</span>
                                <span class="value">
                                    @if (_browserLat != null && _browserLon != null)
                                    {
                                        var lat = _browserLat.Value;
                                        var lon = _browserLon.Value;
                                        @($"{Math.Abs(lat):F4}°{(lat >= 0 ? "N" : "S")}, {Math.Abs(lon):F4}°{(lon >= 0 ? "E" : "W")}")
                                    }
                                    else
                                    {
                                        @("--")
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-sm" @onclick="SyncLocation" disabled="@(_isLoading)">Sync</button>
                </div>
            }
        </section>

        <!-- Position Display -->
        <section class="panel position-panel @(!NexStar.ComsEnabled ? "disabled-panel" : "")">
            <h2>Position</h2>
            <div class="position-grid">
                <div class="position-card">
                    <h3>Equatorial (RA/Dec)</h3>
                    @if (NexStar.CurrentRaDec != null)
                    {
                        <div class="coord-row">
                            <label>RA:</label>
                            <span class="coord-value">@NexStar.CurrentRaDec.FormatRA()</span>
                        </div>
                        <div class="coord-row">
                            <label>Dec:</label>
                            <span class="coord-value">@NexStar.CurrentRaDec.FormatDec()</span>
                        </div>
                    }
                    else
                    {
                        <p class="no-data">No data</p>
                    }
                </div>
                <div class="position-card">
                    <h3>Horizontal (Az/Alt)</h3>
                    @if (NexStar.CurrentAzAlt != null)
                    {
                        <div class="coord-row">
                            <label>Az:</label>
                            <span class="coord-value">@NexStar.CurrentAzAlt.FormatAz()</span>
                        </div>
                        <div class="coord-row">
                            <label>Alt:</label>
                            <span class="coord-value">@NexStar.CurrentAzAlt.FormatAlt()</span>
                        </div>
                    }
                    else
                    {
                        <p class="no-data">No data</p>
                    }
                </div>
            </div>
            <div class="button-row">
                <button class="btn btn-sm" @onclick="UpdatePosition" disabled="@(_isLoading || !NexStar.ComsEnabled)">
                    ↻ Update Position
                </button>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="_autoUpdatePosition" disabled="@(!NexStar.ComsEnabled)" />
                    Auto-update
                </label>
            </div>
        </section>

        <!-- Quick Access -->
        <section class="panel quick-access-panel @(!NexStar.ComsEnabled ? "disabled-panel" : "")">
            <h2>🎯 Quick Access</h2>
            <div class="quick-targets">
                <div class="quick-targets">
                    @foreach (var target in _quickTargets)
                    {
                        <button class="quick-btn" @onclick="@(() => QuickGoto(target))"
                                disabled="@(!NexStar.ComsEnabled)">
                            @target.DisplayName
                        </button>
                    }
                </div>
            </div>
            <div class="quick-links">
                <a href="objects" class="link-btn">🌌 Object Browser</a>
                <a href="alignment" class="link-btn">⭐ Alignment Helper</a>
            </div>
        </section>

        <!-- Manual Slew Controls -->
        <section class="panel slew-panel @(!NexStar.ComsEnabled ? "disabled-panel" : "")">
            <h2>Manual Slew</h2>
            <div class="slew-controls">
                <div class="dpad">
                    <button type="button" class="dpad-btn north"
                            @onclick="@(async () => await SlewNorth())"
                            disabled="@(!NexStar.ComsEnabled)">
                        ▲<br />N
                    </button>
                    <button type="button" class="dpad-btn west"
                            @onclick="@(async () => await SlewWest())"
                            disabled="@(!NexStar.ComsEnabled)">
                        ◀ W
                    </button>
                    <button type="button" class="dpad-btn stop" @onclick="StopAll" disabled="@(!NexStar.ComsEnabled)">■</button>
                    <button type="button" class="dpad-btn east"
                            @onclick="@(async () => await SlewEast())"
                            disabled="@(!NexStar.ComsEnabled)">
                        E ▶
                    </button>
                    <button type="button" class="dpad-btn south"
                            @onclick="@(async () => await SlewSouth())"
                            disabled="@(!NexStar.ComsEnabled)">
                        S<br />▼
                    </button>
                </div>
                <div class="slew-rate-control">
                    <label>Slew Rate: @_slewRate</label>
                    <input type="range" min="1" max="9" @bind="_slewRate" @bind:event="oninput" disabled="@(!NexStar.ComsEnabled)" />
                    <div class="rate-labels">
                        <span>Slow</span>
                        <span>Fast</span>
                    </div>
                </div>
            </div>
            <p class="slew-hint">@(NexStar.ComsEnabled ? "Click a direction to start slewing. Click ■ to stop." : "Connect to telescope to enable slewing controls.")</p>
        </section>


        <!-- GoTo Panel -->
        <section class="panel goto-panel @(!NexStar.ComsEnabled ? "disabled-panel" : "")">
            <h2>GoTo Coordinates</h2>
            <div class="goto-form">
                <div class="input-group">
                    <label>RA (hours):</label>
                    <input type="number" step="0.001" min="0" max="24" @bind="_gotoRaHours" placeholder="0.000" disabled="@(!NexStar.ComsEnabled)" />
                </div>
                <div class="input-group">
                    <label>Dec (degrees):</label>
                    <input type="number" step="0.01" min="-90" max="90" @bind="_gotoDec" placeholder="0.00" disabled="@(!NexStar.ComsEnabled)" />
                </div>
                <div class="button-row">
                    <button class="btn btn-primary" @onclick="ExecuteGoto" disabled="@(_isLoading || !NexStar.ComsEnabled)">
                        🎯 Go To
                    </button>
                    <button class="btn btn-warning" @onclick="CancelGoto" disabled="@(_isLoading || !NexStar.ComsEnabled)">
                        ✕ Cancel
                    </button>
                </div>
            </div>
        </section>

        <!-- Tracking Mode -->
        <section class="panel tracking-panel @(!NexStar.ComsEnabled ? "disabled-panel" : "")">
            <h2>Tracking</h2>
            <div class="tracking-buttons">
                @foreach (TrackingMode mode in Enum.GetValues<TrackingMode>())
                {
                    <button class="btn @(NexStar.CurrentTrackingMode == mode ? "btn-primary" : "btn-secondary")"
                            @onclick="@(() => SetTracking(mode))"
                            disabled="@(_isLoading || !NexStar.ComsEnabled)">
                        @mode
                    </button>
                }
            </div>
        </section>

    </main>
</div>

@code {
    private bool _isLoading = false;
    private string _statusMessage = "";
    private string _statusClass = "";
    private int _slewRate = 5;
    private double _gotoRaHours = 0;
    private double _gotoDec = 0;
    private bool _autoUpdatePosition = false;

    private TelescopeTime? _telescopeTime;
    private System.Timers.Timer? _positionTimer;

    // Sync Status
    private TimeSpan _timeDiff;
    private double _locationDiffKm;
    private double? _browserLat;
    private double? _browserLon;
    private int _timerTicks = 0;

    // Quick Targets Cache
    private List<CelestialObject> _quickTargets = new();

    // Limits
    private const double TIME_DIFF_THRESHOLD_WARN = 60; // 1 min
    private const double TIME_DIFF_THRESHOLD_ERR = 300; // 5 mins
    private const double DIST_DIFF_THRESHOLD_WARN = 2.0; // km
    private const double DIST_DIFF_THRESHOLD_ERR = 20.0; // km

    protected override void OnInitialized()
    {
        NexStar.OnStatusChanged += HandleStatusChanged;
        _positionTimer = new System.Timers.Timer(1000);
        _positionTimer.Elapsed += async (s, e) =>
        {
            await AutoUpdatePosition();
            _timerTicks++;
            if (_timerTicks % 60 == 0) // Every 60 seconds
            {
                await InvokeAsync(async () =>
                {
                    if (NexStar.ComsEnabled)
                    {
                        await GetTime();
                        await CheckSyncStatus();
                    }
                });
            }
        };
        _positionTimer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && NexStar.ComsEnabled)
        {
            await RestoreState();
        }
    }

    private async Task RestoreState()
    {
        _statusMessage = $"Connected to {NexStar.Model.GetDisplayName()}";
        _statusClass = "success";

        // Refresh all data
        await UpdatePosition();
        await GetTime();
        // Recalculate quick targets based on location
        RefreshQuickTargets();

        // Trigger sync check
        await CheckSyncStatus();

        StateHasChanged();
    }

    private async Task DeselectPort()
    {
        _isLoading = true;
        await NexStar.DeselectPortAsync();
        _statusMessage = "";
        _isLoading = false;
        StateHasChanged();
    }

    private Task ConnectUSB() => Connect(true);
    private Task ConnectSerial() => Connect(false);
    private async Task Connect(bool useWebUSB = false)
    {
        _isLoading = true;
        _statusMessage = "Connecting...";
        _statusClass = "info";
        StateHasChanged();

        await NexStar.SelectPortAsync(useWebUSB);

        if (NexStar.ComsEnabled)
        {
            _statusMessage = $"Connected to {NexStar.Model.GetDisplayName()}";
            _statusClass = "success";
            await UpdatePosition();
            await GetTime();
            await NexStar.GetLocationAsync();
            RefreshQuickTargets();
            await CheckSyncStatus();
        }
        else
        {
            _statusMessage = "Connection failed.";
            _statusClass = "error";
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task Disconnect()
    {
        _isLoading = true;
        _positionTimer?.Stop();
        await NexStar.DeselectPortAsync();
        _statusMessage = "Disconnected.";
        _statusClass = "info";
        _isLoading = false;
        StateHasChanged();
    }

    private async Task RefreshInfo()
    {
        _isLoading = true;
        await NexStar.RefreshTelescopeInfoAsync();
        await UpdatePosition();
        await GetTime();
        await NexStar.GetLocationAsync();
        await CheckSyncStatus();
        RefreshQuickTargets();
        _isLoading = false;
        StateHasChanged();
    }

    private async Task UpdatePosition()
    {
        await NexStar.GetRaDecAsync();
        await NexStar.GetAzAltAsync();
        StateHasChanged();
    }

    private async Task AutoUpdatePosition()
    {
        if (_autoUpdatePosition && NexStar.ComsEnabled)
        {
            await UpdatePosition();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SlewNorth()
    {
        var rate = (SlewRate)_slewRate;

        var result = await NexStar.SlewFixedAsync(SlewAxis.DecAlt, SlewDirection.Positive, rate);
        _statusMessage = result ? $"Slewing North at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task SlewSouth()
    {
        var rate = (SlewRate)_slewRate;
        var result = await NexStar.SlewFixedAsync(SlewAxis.DecAlt, SlewDirection.Negative, rate);
        _statusMessage = result ? $"Slewing South at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task SlewEast()
    {
        var rate = (SlewRate)_slewRate;
        var result = await NexStar.SlewFixedAsync(SlewAxis.RaAzm, SlewDirection.Positive, rate);
        _statusMessage = result ? $"Slewing East at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task SlewWest()
    {
        var rate = (SlewRate)_slewRate;
        var result = await NexStar.SlewFixedAsync(SlewAxis.RaAzm, SlewDirection.Negative, rate);
        _statusMessage = result ? $"Slewing West at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task StopAll()
    {
        await NexStar.StopAllSlewAsync();
        await NexStar.CancelGotoAsync();
        _statusMessage = "All motion stopped.";
        _statusClass = "warning";
        StateHasChanged();
    }

    private IEnumerable<CelestialObject> GetQuickTargets()
    {
        return _quickTargets;
    }

    private async Task QuickGoto(CelestialObject target)
    {
        _statusMessage = $"Slewing to {target.DisplayName}...";
        _statusClass = "info";
        StateHasChanged();

        var result = await NexStar.GotoRaDecAsync(target.RightAscension, target.Declination);

        if (result)
        {
            _statusMessage = $"GoTo {target.DisplayName} initiated.";
            _statusClass = "success";
        }
        else
        {
            _statusMessage = "GoTo failed.";
            _statusClass = "error";
        }
        StateHasChanged();
    }

    private async Task ExecuteGoto()
    {
        _isLoading = true;
        _statusMessage = "Slewing to target...";
        _statusClass = "info";
        StateHasChanged();

        // Convert RA from hours to degrees
        var raDeg = _gotoRaHours * 15.0;
        var result = await NexStar.GotoRaDecAsync(raDeg, _gotoDec);

        if (result)
        {
            _statusMessage = "GoTo command sent.";
            _statusClass = "success";
        }
        else
        {
            _statusMessage = "GoTo failed.";
            _statusClass = "error";
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task CancelGoto()
    {
        await NexStar.CancelGotoAsync();
        _statusMessage = "GoTo cancelled.";
        _statusClass = "warning";
        StateHasChanged();
    }

    private async Task SetTracking(TrackingMode mode)
    {
        _isLoading = true;
        await NexStar.SetTrackingModeAsync(mode);
        _isLoading = false;
        StateHasChanged();
    }

    private async Task GetTime()
    {
        _telescopeTime = await NexStar.GetTimeAsync();
        StateHasChanged();
    }

    private async Task SyncTime()
    {
        _isLoading = true;
        var result = await NexStar.SyncTimeAsync();
        if (result)
        {
            _statusMessage = "Time synced.";
            _statusClass = "success";
            await GetTime();
        }
        else
        {
            _statusMessage = "Time sync failed.";
            _statusClass = "error";
        }
        _isLoading = false;
        await CheckSyncStatus();
        StateHasChanged();
    }

    private async Task SyncLocation()
    {
        _isLoading = true;
        _statusMessage = "Requesting Browser Location...";
        _statusClass = "info";
        StateHasChanged();

        try
        {
            using var navigator = JS.Get<SpawnDev.SpawnJS.JSObjects.Navigator>("navigator");
            using var geolocation = navigator.Geolocation;
            if (geolocation == null)
            {
                _statusMessage = "Geolocation not supported.";
                _statusClass = "error";
            }
            else
            {
                var pos = await geolocation.GetCurrentPositionAsync();
                var lat = pos.Coords.Latitude;
                var lon = pos.Coords.Longitude;

                _statusMessage = "Setting telescope location...";
                StateHasChanged();

                var success = await NexStar.SetLocationAsync(lat, lon);
                if (success)
                {
                    _statusMessage = "Location updated.";
                    _statusClass = "success";
                    await GetLocation(); // Refresh from scope
                }
                else
                {
                    _statusMessage = "Failed to set location.";
                    _statusClass = "error";
                }
            }
        }
        catch (Exception ex)
        {
            _statusMessage = "Sync failed: " + ex.Message;
            _statusClass = "error";
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task GetLocation()
    {
        await NexStar.GetLocationAsync();
        RefreshQuickTargets();
        await CheckSyncStatus();
        StateHasChanged();
    }

    private async Task CheckSyncStatus()
    {
        if (!NexStar.ComsEnabled) return;

        if (_telescopeTime != null)
        {
            var now = DateTime.Now;
            var scopeTime = _telescopeTime.LocalTime;
            _timeDiff = scopeTime - now;
        }

        // 2. Location Check
        // If we don't have browser location yet, try to get it (silently/quickly)
        if (_browserLat == null)
        {
            try
            {
                using var navigator = JS.Get<SpawnDev.SpawnJS.JSObjects.Navigator>("navigator");
                using var geolocation = navigator.Geolocation;
                if (geolocation != null)
                {
                    // Use a short timeout to avoid blocking
                    var pos = await geolocation.GetCurrentPositionAsync();
                    _browserLat = pos.Coords.Latitude;
                    _browserLon = pos.Coords.Longitude;
                }
            }
            catch { /* Ignore silent failure */ }
        }

        if (_browserLat != null && _browserLon != null && NexStar.Location != null)
        {
            _locationDiffKm = AstronomyMath.CalculateDistanceKm(_browserLat.Value, _browserLon.Value, NexStar.Location.Latitude, NexStar.Location.Longitude);
        }
    }

    private string GetTimeDriftClass()
    {
        var absSeconds = Math.Abs(_timeDiff.TotalSeconds);
        if (absSeconds < TIME_DIFF_THRESHOLD_WARN) return "status-good";
        if (absSeconds < TIME_DIFF_THRESHOLD_ERR) return "status-warn";
        return "status-error";
    }

    private string GetLocationDriftClass()
    {
        if (_browserLat == null) return "muted";
        if (_locationDiffKm < DIST_DIFF_THRESHOLD_WARN) return "status-good";
        if (_locationDiffKm < DIST_DIFF_THRESHOLD_ERR) return "status-warn";
        return "status-error";
    }

    private string GetFriendlyTimeSpan(TimeSpan ts)
    {
        if (Math.Abs(ts.TotalSeconds) < 60) return $"{Math.Round(ts.TotalSeconds)}s";
        return $"{Math.Round(ts.TotalMinutes)}m";
    }

    private void RefreshQuickTargets()
    {
        _quickTargets = NexStar.GetVisibleQuickTargets().ToList();
    }

    private void HandleStatusChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NexStar.OnStatusChanged -= HandleStatusChanged;
        _positionTimer?.Stop();
        _positionTimer?.Dispose();
    }
}

<style>
    /* ========================================
           Home Page - Night Mode Theme
           Optimized for low-light astronomical viewing
           ======================================== */

    .telescope-app {
        font-family: 'Inter', 'Segoe UI', -apple-system, sans-serif;
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem;
        color: #d4d4d8;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        background: linear-gradient(135deg, #0d0d10 0%, #131318 100%);
        border: 1px solid rgba(197, 48, 48, 0.2);
        color: white;
        border-radius: 16px;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

        .app-header h1 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
            background: linear-gradient(135deg, #fff 0%, #c53030 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .connection-status {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .status {
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .status::before {
            content: '';
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }

        .status.connected {
            color: #4ade80;
        }

            .status.connected::before {
                background: #4ade80;
                box-shadow: 0 0 10px #4ade80;
            }

        .status.ready {
            color: #fbbf24;
        }

            .status.ready::before {
                background: #fbbf24;
                box-shadow: 0 0 10px #fbbf24;
            }

        .status.disconnected {
            color: #71717a;
        }

            .status.disconnected::before {
                background: #71717a;
            }

    .model-info {
        color: #71717a;
        font-size: 0.85rem;
    }

    .app-main {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.25rem;
    }

    .panel {
        background: linear-gradient(180deg, #131318 0%, #0f0f12 100%);
        border: 1px solid #27272a;
        border-radius: 16px;
        padding: 1.5rem;
        color: #d4d4d8;
        transition: border-color 0.3s ease;
